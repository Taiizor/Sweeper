{
  "Sweeper": {
    "Language": "en-US",
    "Verbose": false,
    "Quiet": false,
    "Force": false,
    "DryRun": false,
    "Recursive": true,
    "ParallelOperations": 4,
    "DefaultCategories": [ "SystemTemp", "UserTemp" ],
    "ExcludePaths": [],
    "IncludePaths": [],
    "AutoConfirm": false,
    "ShowProgress": true,
    "UseRecycleBin": true,
    "MinimumFileAge": 0,
    "MinimumFileSize": 0,
    "LogLevel": "Information",
    "LogPath": "",
    "EnableTelemetry": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  }
}
